{
  "name": "digital-goods-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --schema=prisma/schema.prisma && prisma generate --schema=prisma/bot/schema.prisma && next build",
    "start": "next start",
    "start:all": "node scripts/start-all.mjs",
    "lint": "next lint",
    "postinstall": "prisma generate --schema=prisma/schema.prisma && prisma generate --schema=prisma/bot/schema.prisma",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "setup": "prisma db push && tsx --conditions=react-server prisma/seed.ts",
    "bot": "tsx --conditions=react-server src/bot/index.ts",
    "admin:create": "node --env-file=.env scripts/create-admin.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx --conditions=react-server prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.0",
    "grammy": "^1.44.0",
    "ioredis": "^5.4.1",
    "isomorphic-dompurify": "^2.14.0",
    "marked": "^13.0.3",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "^18.4.0-beta.17",
    "postcss": "^8.4.41",
    "prisma": "^5.18.0",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
