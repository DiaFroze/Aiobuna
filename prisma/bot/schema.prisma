// Second Prisma client: the SubHub BOT's SQLite database. Shared by BOTH the
// admin panel (manages catalog: products/plans/variants/texts/emoji) AND the
// Telegram store bot (src/bot), which owns the commerce tables below
// (BotUser/StockItem/BotOrder/TopUp). We own this DB, so `prisma db push
// --schema=prisma/bot/schema.prisma` IS the way to apply changes here.

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/bot-client"
}

datasource db {
  provider = "sqlite"
  url      = env("BOT_DATABASE_URL")
}

model Product {
  id           Int     @id @default(autoincrement())
  code         String  @unique
  titleRu      String
  titleUz      String
  titleEn      String  @default("")
  emoji        String  @default("✨")
  premiumEmoji String? // Telegram custom_emoji_id (string)
  bannerFileId String?
  descRu       String  @default("")
  descUz       String  @default("")
  descEn       String  @default("")
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)
  plans        Plan[]
}

model Plan {
  id        Int       @id @default(autoincrement())
  productId Int
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  titleRu   String
  titleUz   String
  emoji     String    @default("")
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  variants  Variant[]
}

model Variant {
  id                 Int     @id @default(autoincrement())
  planId             Int
  plan               Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  titleRu            String
  titleUz            String
  durationDays       Int     @default(30)
  priceUzs           Int     @default(0)
  priceStars         Int     @default(0)
  priceUsdt          Float   @default(0)
  pointsCost         Int     @default(0)
  sortOrder          Int     @default(0)
  isActive           Boolean @default(true)
  supplierKey        String?
  supplierExternalId String?
  supplierPriceUsdt  Float   @default(0)
  supplierStock      Int     @default(0)
  autoSupplier       Boolean @default(false)
  manualDelivery     Boolean @default(false) // admin delivers login/pass manually after payment
  manualStockLimit   Int     @default(-1)    // -1 = infinite, >=0 = manual stock limit

  stockItems StockItem[]

  @@unique([supplierKey, supplierExternalId])
}

model Setting {
  key       String   @id
  valueRu   String   @default("")
  valueUz   String   @default("")
  fileId    String?
  type      String   @default("text")
  updatedAt DateTime @updatedAt
}

// --- Commerce tables owned by the Telegram store bot (src/bot) ---

model BotUser {
  id         Int      @id @default(autoincrement())
  tgId       String   @unique // Telegram user id (string — precision-safe)
  username   String?
  firstName  String?
  lang       String   @default("ru")
  balance    Float    @default(0) // сум
  referredBy String? // tgId of the inviter (Refer & Earn)
  refRewardClaimed Boolean @default(false) // referral promo already granted
  isFormatterAllowed Boolean @default(false) // authorized to use the link formatter command /code
  createdAt  DateTime @default(now())
  orders     BotOrder[]
  topups     TopUp[]
}

// One deliverable unit of stock (login:pass / key / code). "Stock: N" shown in
// the bot = count of unsold items for a variant. Purchase delivers one item.
model StockItem {
  id        Int       @id @default(autoincrement())
  variantId Int
  variant   Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  payload   String // the content handed to the buyer
  isSold    Boolean   @default(false)
  soldAt    DateTime?
  orderId   Int?
  createdAt DateTime  @default(now())

  @@index([variantId, isSold])
}

model BotOrder {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      BotUser  @relation(fields: [userId], references: [id])
  variantId Int? // snapshot only — NOT an FK, so deleting a product never fails
  titleRu   String // snapshot of what was sold
  priceUsdt Float
  payload   String // delivered content snapshot
  source    String   @default("stock") // stock | vex (auto-fulfilled from supplier)
  status    String   @default("delivered")
  createdAt DateTime @default(now())
}

// Supplier API sources — added/edited from the admin panel so new reseller APIs
// can be plugged in without code. `slug` is stored on Variant.supplierKey.
model ApiSource {
  id        Int      @id @default(autoincrement())
  slug      String   @unique // used as Variant.supplierKey (e.g. "vex")
  name      String
  baseUrl   String
  apiKey    String
  format    String   @default("vex") // request/response contract
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model TopUp {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       BotUser  @relation(fields: [userId], references: [id])
  amount     Float // сум credited
  method     String   @default("manual") // manual | stars | card | receipt
  status     String   @default("pending") // pending | awaiting_receipt | approved | rejected | review
  note       String?
  externalId String? // Telegram charge id / card provider ref
  expiresAt  DateTime? // receipt-payment deadline (10 min window)
  receiptFileId String? // Telegram file_id of the sent receipt image
  txnRef     String? // transaction reference extracted from the receipt (dedupe)
  createdAt  DateTime @default(now())
}
